{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": { "timeout": 600000 }
    }
  },
  "model": "opencode/glm-4.7-free", // Your main project model
  "small_model": "opencode/glm-4.7-free", // For lightweight tasks
  "theme": "everforest",
  "lsp": {
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "pyright": {
      "disabled": true
    }
  }
}
